{
  "name": "hwadmin-ui",
  "version": "1.6.4",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10 <11"
  },
  "type": "module",
  "author": "HwAdmin Team",
  "scripts": {
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:dev:web": "vite --mode desktop",
    "desktop:build": "tauri build",
    "desktop:build:web": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --mode desktop",
    "test:desktop": "node --test packages/pc-core/test/desktop.test.mjs",
    "desktop:check": "pnpm vue-tsc && pnpm test:desktop && pnpm desktop:build:web && cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "mobile:install": "pnpm --dir mobile install --frozen-lockfile",
    "mobile:dev": "pnpm --dir mobile dev",
    "mobile:dev:mp": "pnpm --dir mobile dev:mp",
    "mobile:build": "pnpm --dir mobile build",
    "mobile:build:h5": "pnpm --dir mobile build:h5",
    "mobile:check": "pnpm --dir mobile check",
    "test:core": "node --test packages/pc-core/test/runtime.test.mjs packages/pc-core/test/branding.test.mjs packages/pc-core/test/security.test.mjs packages/pc-core/test/deployment.test.mjs packages/pc-core/test/desktop.test.mjs",
    "dev": "cross-env VITE_CONFIG_NATIVE_IGNORE_WARNING=true vite",
    "dev:vue-tsc": "vue-tsc --noEmit && cross-env VITE_CJS_IGNORE_WARNING=true vite",
    "dev:https": "cross-env VITE_CJS_IGNORE_WARNING=true vite --config ./vite.config.dev.ts",
    "vue-tsc": "vue-tsc --noEmit",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:sync": "pnpm build && node scripts/sync-to-server.mjs",
    "check": "pnpm vue-tsc && pnpm lint:oxlint && pnpm test:core && pnpm build",
    "preview": "cross-env VITE_CJS_IGNORE_WARNING=true vite preview",
    "lint:eslint": "eslint . --fix",
    "lint:oxlint": "oxlint",
    "lint:oxlint:fix": "oxlint --fix",
    "lint:prettier": "prettier {src,library,types}/**/*.{html,vue,css,sass,scss,js,ts} --write",
    "lint:stylelint": "stylelint {src,library}/**/*.{vue,css,sass,scss} --fix --cache --cache-location node_modules/.cache/stylelint/",
    "generate-pwa-assets": "pwa-assets-generator"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@vueuse/core": "^14.4.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.19.0",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.17",
    "element-plus": "^2.14.3",
    "lodash-es": "^4.18.1",
    "marked": "^18.0.9",
    "mitt": "^3.0.1",
    "normalize.css": "^8.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.2",
    "qs": "^6.17.0",
    "remixicon": "4.9.1",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/lodash-es": "^4.17.12",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.15.1",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "^3.5.41",
    "adm-zip": "^0.6.0",
    "autoprefixer": "^10.5.4",
    "chokidar": "^3.6.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^73.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.77.0",
    "picocolors": "^1.1.1",
    "postcss": "^8.5.26",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "terser": "^5.49.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "oxlint --fix",
      "pnpm run lint:prettier",
      "git add"
    ]
  },
  "files": [],
  "pnpm": {
    "overrides": {
      "source-map-js": "^1.2.2",
      "follow-redirects": "^1.16.1"
    }
  }
}
