# Copy to .env.local (ignored). These values are public client configuration.
# Never put AppSecret, signing keys or administrator tokens here.
VITE_APP_TITLE=HwAdmin Mobile
VITE_WX_APPID=
# Backend origin only; /api is appended by the request layer.
# Required on real WeChat devices; use an HTTPS domain in production.
VITE_API_ORIGIN=
# Local H5 development proxy. Relative /api is used by H5.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
