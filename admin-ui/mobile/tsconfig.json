{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "types": [
      "@dcloudio/types",
      "@uni-helper/uni-types",
      "@uni-helper/vite-plugin-uni-pages/client",
      "@wot-ui/ui/global",
      "miniprogram-api-typings",
      "vite/client",
      "node"
    ]
  },
  "vueCompilerOptions": { "plugins": ["@uni-helper/uni-types/volar-plugin"] },
  "include": ["src/**/*.ts", "src/**/*.vue", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
