{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Embedded HwAdmin frontend may open HTTP(S) links in the system browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }, { "url": "http://*" }] }
  ]
}
