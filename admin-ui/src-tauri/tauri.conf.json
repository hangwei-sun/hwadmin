{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HwAdmin",
  "version": "../package.json",
  "identifier": "com.hwadmin.desktop",
  "build": {
    "beforeDevCommand": "pnpm desktop:dev:web",
    "devUrl": "http://127.0.0.1:15174",
    "beforeBuildCommand": "pnpm desktop:build:web",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HwAdmin",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "dragDropEnabled": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http://127.0.0.1:8000; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https: http://127.0.0.1:8000; frame-src 'self' https: http://127.0.0.1:8000; media-src 'self' blob: https: http://127.0.0.1:8000; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "HwAdmin 桌面工作台",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "languages": ["SimpChinese", "English"], "displayLanguageSelector": true }
    }
  }
}
