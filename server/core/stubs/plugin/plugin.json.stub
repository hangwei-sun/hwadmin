{
    "name": "{{name}}",
    "title": "{{Name}} 插件",
    "version": "1.0.0",
    "description": "请填写插件说明",
    "author": "",
    "require": {
        "hwadmin": ">=0.1.0",
        "php": ">=8.2"
    },
    "menus": [
        {
            "type": "dir",
            "title": "{{Name}}",
            "path": "{{name}}",
            "icon": "apps-line",
            "children": [
                {
                    "type": "menu",
                    "name": "plugin/{{name}}/index",
                    "title": "首页",
                    "path": "index",
                    "component": "plugin:{{name}}/Index",
                    "children": [
                        { "type": "button", "name": "plugin/{{name}}/index/index", "title": "查看" }
                    ]
                }
            ]
        }
    ],
    "config": [
        { "name": "welcome", "title": "欢迎语", "type": "string", "value": "Hello HwAdmin" }
    ]
}
