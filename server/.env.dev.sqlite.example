# HwAdmin 本地轻量级 SQLite 敏捷开发配置示例
# 复制为 server/.env 后即可免装 MySQL 直接启动开发与自动化验证

APP_ENV = local
APP_DEBUG = true
DEFAULT_LANG = zh-cn

# SQLite 零配置本地开发库（建议使用绝对路径或相对 server/ 的路径）
DB_DRIVER = sqlite
DB_TYPE = sqlite
DB_NAME = runtime/hwadmin.sqlite
DB_HOST =
DB_PORT =
DB_USER =
DB_PASS =
DB_PREFIX = hw_

CACHE_DRIVER = file

HW_ADMIN_TOKEN_TTL = 86400
HW_USER_TOKEN_TTL = 2592000
HW_CORS_ORIGINS = http://localhost:15173,http://127.0.0.1:15173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5200,http://127.0.0.1:5200
