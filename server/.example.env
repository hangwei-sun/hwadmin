# HwAdmin 环境配置示例。复制为 .env 后修改；安装向导会自动生成 .env。
# 切勿把 .env 提交到仓库。

APP_DEBUG = false
DEFAULT_LANG = zh-cn

# 数据库：mysql（推荐 MySQL 8.0+/8.4 LTS，兼容 MariaDB 10.6+）、pgsql（PostgreSQL 14+）或 sqlite
# 若本地快速使用 SQLite，可设 DB_DRIVER = sqlite / DB_TYPE = sqlite / DB_NAME = runtime/hwadmin.sqlite
DB_DRIVER = mysql
DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_PORT = 3306
DB_NAME = hwadmin
DB_USER = hwadmin_app
DB_PASS =
DB_CHARSET = utf8mb4
DB_PREFIX = hw_

# 缓存：file（默认，零依赖）或 redis
CACHE_DRIVER = file
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_PASSWORD =
REDIS_SELECT = 0

# 令牌有效期（秒）
HW_ADMIN_TOKEN_TTL = 86400
HW_USER_TOKEN_TTL = 2592000

# 跨域允许的来源，多个用英文逗号分隔；同域部署留空即可
HW_CORS_ORIGINS =

# 官方应用商城默认网关地址（留空即使用官方正式域名 https://hw.baotoutv.cn）
MARKET_SERVER_URL =
