{
    "name": "hwadmin/server",
    "description": "HwAdmin 后端：基于 ThinkPHP 8 的前后端分离、插件化后台框架",
    "type": "project",
    "keywords": ["admin", "thinkphp", "plugin", "rbac"],
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ezyang/htmlpurifier": "^4.19",
        "topthink/framework": "^8.1",
        "topthink/think-filesystem": "^3.0",
        "topthink/think-migration": "^3.1",
        "topthink/think-multi-app": "^1.1",
        "topthink/think-orm": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "topthink/think-trace": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app",
            "core\\": "core",
            "plugins\\": "plugins"
        },
        "classmap": [
            "extend/"
        ],
        "files": [
            "core/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ]
    }
}
