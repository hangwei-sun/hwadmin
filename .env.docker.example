# ==============================================================================
# HwAdmin Docker 容器化部署环境变量模板 (.env.docker.example)
# 使用方式：
#   1. 复制为 .env：cp .env.docker.example .env
#   2. 将下方 CHANGE_ME_* 占位符替换为高强度随机密码
#   3. 默认 MySQL 8.0 启动：docker compose up -d
#      切换 PostgreSQL 16 启动：docker compose --profile pgsql up -d（或设 COMPOSE_PROFILES=pgsql）
# ==============================================================================

COMPOSE_PROJECT_NAME=hwadmin
COMPOSE_PROFILES=mysql
HTTP_PORT=8080
APP_DEBUG=false

# 数据库配置（默认 MySQL 8.0；切换 PostgreSQL 16 时建议同步修改 COMPOSE_PROFILES=pgsql / DB_DRIVER=pgsql / DB_TYPE=pgsql / DB_HOST=hwadmin-pg / DB_PORT=5432）
DB_DRIVER=mysql
DB_TYPE=mysql
DB_HOST=hwadmin-mysql
DB_PORT=3306
DB_NAME=hwadmin
DB_USER=hwadmin_app
DB_PASS=CHANGE_ME_DB_PASS_RANDOM_32CHARS
DB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_RANDOM_32CHARS
DB_PREFIX=hw_
PG_USER=hwadmin_app

# Redis 缓存配置
CACHE_DRIVER=redis
REDIS_HOST=hwadmin-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASS_RANDOM_32CHARS

# 首次冷启动初始化管理员账号（若留空 ADMIN_INIT_PASSWORD，hwadmin-init-* 将自动生成随机强口令并写入 runtime/docker-init-admin.txt）
ADMIN_INIT_USER=admin
ADMIN_INIT_PASSWORD=
