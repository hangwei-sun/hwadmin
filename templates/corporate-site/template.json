{
  "name": "corporate-site",
  "title": "企业官网起步模板",
  "version": "1.0.0",
  "description": "适用于企业官方网站，支持品牌形象展示、产品/服务中心、文章/新闻动态独立详情页、SEO/Sitemap/Robots、客户在线询盘与管理端维护",
  "author": "HwAdmin Team",
  "modules": [
    {
      "id": "corporate-site",
      "title": "企业官网门户",
      "description": "品牌官网展示、产品/文章独立详情、页面级 SEO/Sitemap/Robots 与在线询盘管理"
    }
  ],
  "entities": [
    "site_category",
    "site_article",
    "site_inquiry"
  ],
  "entities_schema": {
    "site_category": {
      "table": "site_category",
      "title": "官网栏目分类",
      "primary_key": "id",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "title": "ID",
          "primary": true
        },
        {
          "name": "name",
          "type": "string",
          "title": "栏目名称",
          "length": 64,
          "nullable": false
        },
        {
          "name": "slug",
          "type": "string",
          "title": "URL别名",
          "length": 64,
          "nullable": false,
          "default": ""
        },
        {
          "name": "sort",
          "type": "integer",
          "title": "排序权重",
          "nullable": false,
          "default": 0
        },
        {
          "name": "status",
          "type": "integer",
          "title": "状态",
          "nullable": false,
          "default": 1
        },
        {
          "name": "create_time",
          "type": "biginteger",
          "title": "创建时间",
          "nullable": false,
          "default": 0
        },
        {
          "name": "update_time",
          "type": "biginteger",
          "title": "更新时间",
          "nullable": false,
          "default": 0
        }
      ]
    },
    "site_article": {
      "table": "site_article",
      "title": "官网文章与产品",
      "primary_key": "id",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "title": "ID",
          "primary": true
        },
        {
          "name": "category_id",
          "type": "integer",
          "title": "栏目分类ID",
          "nullable": false,
          "default": 0
        },
        {
          "name": "type",
          "type": "string",
          "title": "内容类型(article|product)",
          "length": 32,
          "nullable": false,
          "default": "article"
        },
        {
          "name": "title",
          "type": "string",
          "title": "标题",
          "length": 255,
          "nullable": false
        },
        {
          "name": "slug",
          "type": "string",
          "title": "URL别名",
          "length": 128,
          "nullable": false,
          "default": ""
        },
        {
          "name": "summary",
          "type": "string",
          "title": "摘要",
          "length": 500,
          "nullable": false,
          "default": ""
        },
        {
          "name": "content",
          "type": "text",
          "title": "正文详情",
          "nullable": true
        },
        {
          "name": "cover_image",
          "type": "string",
          "title": "封面图",
          "length": 255,
          "nullable": false,
          "default": ""
        },
        {
          "name": "price",
          "type": "decimal",
          "title": "产品价格",
          "precision": 10,
          "scale": 2,
          "nullable": false,
          "default": "0.00"
        },
        {
          "name": "views",
          "type": "integer",
          "title": "浏览量",
          "nullable": false,
          "default": 0
        },
        {
          "name": "seo_title",
          "type": "string",
          "title": "SEO标题",
          "length": 255,
          "nullable": false,
          "default": ""
        },
        {
          "name": "seo_keywords",
          "type": "string",
          "title": "SEO关键词",
          "length": 255,
          "nullable": false,
          "default": ""
        },
        {
          "name": "seo_description",
          "type": "string",
          "title": "SEO描述",
          "length": 500,
          "nullable": false,
          "default": ""
        },
        {
          "name": "canonical_url",
          "type": "string",
          "title": "规范链接Canonical",
          "length": 255,
          "nullable": false,
          "default": ""
        },
        {
          "name": "status",
          "type": "integer",
          "title": "状态(1发布,0草稿)",
          "nullable": false,
          "default": 1
        },
        {
          "name": "create_time",
          "type": "biginteger",
          "title": "创建时间",
          "nullable": false,
          "default": 0
        },
        {
          "name": "update_time",
          "type": "biginteger",
          "title": "更新时间",
          "nullable": false,
          "default": 0
        }
      ]
    },
    "site_inquiry": {
      "table": "site_inquiry",
      "title": "客户在线询盘",
      "primary_key": "id",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "title": "ID",
          "primary": true
        },
        {
          "name": "name",
          "type": "string",
          "title": "客户姓名",
          "length": 64,
          "nullable": false
        },
        {
          "name": "mobile",
          "type": "string",
          "title": "联系电话",
          "length": 32,
          "nullable": false,
          "default": ""
        },
        {
          "name": "email",
          "type": "string",
          "title": "电子邮箱",
          "length": 128,
          "nullable": false,
          "default": ""
        },
        {
          "name": "company",
          "type": "string",
          "title": "所属公司",
          "length": 128,
          "nullable": false,
          "default": ""
        },
        {
          "name": "target_id",
          "type": "integer",
          "title": "关联文章或产品ID",
          "nullable": false,
          "default": 0
        },
        {
          "name": "content",
          "type": "text",
          "title": "询盘需求",
          "nullable": true
        },
        {
          "name": "remark",
          "type": "string",
          "title": "跟进备注",
          "length": 255,
          "nullable": false,
          "default": ""
        },
        {
          "name": "status",
          "type": "integer",
          "title": "跟进状态(0待处理,1已联系,2已完成)",
          "nullable": false,
          "default": 0
        },
        {
          "name": "create_time",
          "type": "biginteger",
          "title": "提交时间",
          "nullable": false,
          "default": 0
        },
        {
          "name": "update_time",
          "type": "biginteger",
          "title": "更新时间",
          "nullable": false,
          "default": 0
        }
      ]
    }
  },
